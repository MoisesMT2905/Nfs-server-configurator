[Unit]
Description=YaST2 NFS Server Configuration Helper
Documentation=https://github.com/MoisesMT2905/Nfs-server-configurator
After=dbus.service
Requires=dbus.service

[Service]
Type=dbus
BusName=org.yast2.NFSHelper
ExecStart=/usr/libexec/yast2-nfs-helper
Restart=on-failure
RestartSec=5
User=root

# Security hardening
PrivateTmp=true
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/exports /etc/exports.backup
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictNamespaces=true

[Install]
WantedBy=multi-user.target
Alias=dbus-org.yast2.NFSHelper.service
