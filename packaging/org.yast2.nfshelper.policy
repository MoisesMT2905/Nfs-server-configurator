<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">

<!--
  Polkit policy for YaST2 NFS Helper
  
  This policy allows authorized users to configure NFS exports through
  the privileged D-Bus service.
-->

<policyconfig>
  <vendor>YaST2 NFS Server Configurator</vendor>
  <vendor_url>https://github.com/MoisesMT2905/Nfs-server-configurator</vendor_url>
  
  <action id="org.yast2.nfshelper.apply-configuration">
    <description>Apply NFS export configuration</description>
    <message>Authentication is required to modify NFS export configuration</message>
    <icon_name>network-server</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/exportfs</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
  
</policyconfig>
